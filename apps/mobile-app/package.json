{
  "name": "mobile-app",
  "main": "index.js",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "scripts": {
    "start": "cross-env EXPO_ROUTER_APP_ROOT=app expo start",
    "start:clean": "cross-env EXPO_ROUTER_APP_ROOT=app npx expo start -c --offline",
    "start:lan": "cross-env EXPO_ROUTER_APP_ROOT=app npx expo start --lan",
    "start:lan:clean": "cross-env EXPO_ROUTER_APP_ROOT=app npx expo start -c --lan",
    "android": "cross-env EXPO_ROUTER_APP_ROOT=app expo run:android",
    "ios": "cross-env EXPO_ROUTER_APP_ROOT=app expo run:ios",
    "web": "cross-env EXPO_ROUTER_APP_ROOT=app expo start --web",
    "build:web": "cross-env EXPO_ROUTER_APP_ROOT=app npx expo export -p web"
  },
  "dependencies": {
    "@easy-pay/domain": "*",
    "@easy-pay/ui": "*",
    "@expo/config-plugins": "~55.0.5",
    "@expo/metro-runtime": "~55.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.0.0",
    "@types/react": "~19.1.10",
    "axios": "^1.6.0",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.23",
    "expo-blur": "~55.0.14",
    "expo-camera": "~55.0.18",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-device": "~55.0.16",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image-manipulator": "~55.0.16",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.15",
    "expo-notifications": "~55.0.22",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
