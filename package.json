{
  "name": "easy-pay-monorepo",
  "version": "2.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "setup": "node setup.js",
    "gama": "node setup-gama.js",
    "gama:unach": "node setup-gama.js --unach",
    "gama:usb": "node setup-gama.js --usb",
    "dev:backend": "docker compose up -d",
    "dev:frontend": "docker compose up frontend",
    "dev:mobile": "cd apps/mobile-app && npx expo start -c --lan",
    "dev:web": "npm run dev --workspace=apps/web-app -- --port 5173 --host",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:web\" \"npm run dev:mobile\"",
    "dev": "docker compose up",
    "clean": "npx rimraf node_modules apps/*/node_modules packages/*/node_modules package-lock.json && npm install",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.474.0",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^3.0.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.10",
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "localtunnel": "^2.0.2",
    "metro-runtime": "^0.84.3"
  }
}
