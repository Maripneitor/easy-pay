{
  "name": "easy-pay-monorepo",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "gama": "node setup-gama.js",
    "gama:unach": "node setup-gama.js --unach",
    "gama:usb": "node setup-gama.js --usb",
    "dev:backend": "docker compose up -d unified-api",
    "dev:api": "npm run dev:backend",
    "dev:frontend": "npm run dev:web",
    "dev:mobile": "cd apps/mobile-app && npx expo start -c --lan",
    "dev:web": "npm run dev --workspace=apps/web-app -- --port 5173 --host",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:web\" \"npm run dev:mobile\"",
    "dev": "npm run dev:all",
    "clean": "rimraf node_modules apps/web-app/node_modules apps/mobile-app/node_modules apps/api-backend/node_modules packages/domain/node_modules packages/ui/node_modules package-lock.json && npm install --legacy-peer-deps",
    "nuke": "docker compose down -v --remove-orphans && rimraf node_modules apps/web-app/node_modules apps/mobile-app/node_modules apps/api-backend/node_modules packages/domain/node_modules packages/ui/node_modules package-lock.json && npm cache clean --force && npm install --legacy-peer-deps && docker compose up --build -d unified-api",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~55.0.23",
    "expo-router": "~55.0.14",
    "@expo/metro-runtime": "~55.0.11",
    "expo-secure-store": "~55.0.13",
    "@tanstack/react-query": "^5.0.0",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "tailwindcss": "3.4.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.474.0",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^3.0.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.10",
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "localtunnel": "^2.0.2",
    "metro-runtime": "^0.84.3",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0"
  }
}
